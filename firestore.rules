rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // System collection: readable by anyone, not writable
    match /system/{document} {
      allow read: if true;
      allow write: if false;
    }
    
    // Blogs collection: readable by anyone, writable by authenticated users only
    match /blogs/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Users collection: readable by anyone, writable by authenticated users only
    match /users/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Deny all other paths by default (security best practice)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}